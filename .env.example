# =============================================================================
# Tuesday Configuration
# Copy this file to .env and adjust values as needed.
# Most settings have sensible defaults and are optional.
# =============================================================================

# --- Server ------------------------------------------------------------------
# Port exposed by the container (host-side mapping)
TUESDAY_PORT=7002

# Leave unset for local source builds. For a published deployment, set a release
# digest and use docker compose pull / up --no-build instead of compose build.
# TUESDAY_IMAGE=ghcr.io/sakamotoshun/tuesday@sha256:<release-digest>

# Public URL used for links, redirects, and same-origin detection behind proxies
TUESDAY_BASE_URL=http://localhost:7002

# Required in production. For the single-container deployment, use the same
# origin as TUESDAY_BASE_URL.
CORS_ORIGIN=http://localhost:7002

# --- Database ----------------------------------------------------------------
# Auto-configured for embedded PostgreSQL in Docker.
# Only change if using an external database.
# DATABASE_URL=postgresql://tuesday:tuesday@localhost:5432/tuesday

# --- Security ----------------------------------------------------------------
# Session signing secret. Auto-generated on first run if not set.
# Provide your own for reproducible deployments or multi-instance setups.
# SESSION_SECRET=your-secure-random-string-min-32-chars

# Session duration in hours (default: 24)
# SESSION_DURATION_HOURS=24

# --- Rate Limiting -----------------------------------------------------------
# Enable rate limiting on auth and API endpoints (default: true)
# RATE_LIMIT_ENABLED=true

# Maximum whiteboard WebSocket message size in MB (default: 10, max: 50)
# WHITEBOARD_MAX_MESSAGE_MB=10

# --- File Uploads ------------------------------------------------------------
# Maximum upload size in MB (default: 10)
# UPLOAD_MAX_SIZE_MB=10

# Upload storage path (default: /app/data/uploads)
# UPLOAD_STORAGE_PATH=/app/data/uploads

# Allowed MIME types (default: image/*,application/pdf,text/plain,text/markdown)
# UPLOAD_ALLOWED_TYPES=image/*,application/pdf,text/plain,text/markdown

# Pending upload TTL in minutes (default: 30)
# UPLOAD_PENDING_TTL_MINUTES=30

# --- Advanced ----------------------------------------------------------------
# Data directory inside the container (default: /app/data)
# DATA_DIR=/app/data

# Static file directory (default: /app/static in production)
# STATIC_DIR=/app/static

# Days to retain files from deleted messages (default: 30)
# DELETED_MESSAGE_FILE_RETENTION_DAYS=30

# --- Notification Email Worker ----------------------------------------------
# EMAIL_WORKER_POLL_INTERVAL_MS=1000
# EMAIL_WORKER_BATCH_SIZE=10
# EMAIL_WORKER_LEASE_MS=60000
# EMAIL_WORKER_DRAIN_TIMEOUT_MS=60000
# SMTP_CONNECTION_TIMEOUT_MS=10000
# SMTP_GREETING_TIMEOUT_MS=10000
# SMTP_SOCKET_TIMEOUT_MS=30000
